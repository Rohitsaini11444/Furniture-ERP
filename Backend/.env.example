# Django LAN / Production Environment Template
# Copy to Backend/.env (NEVER commit Backend/.env to Git)

# Set False on Live LAN server, True only during local development
DEBUG=False

# Strong random key (setup-live-lan.ps1 generates one automatically)
SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated hostnames/IPs allowed to access the ERP
ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50

# Trusted origins for Django Admin & CSRF checks
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.50:8000

# Optional extra CORS origins (same-origin LAN mode does not need extra CORS)
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://192.168.1.50:8000

# PostgreSQL Database (default on main)
DB_NAME=erp_furniture_db
DB_USER=erp_app_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=disable

# Optional: uncomment to use SQLite instead of PostgreSQL
# DB_ENGINE=sqlite

# Optional custom media folder (defaults to Backend/media)
# MEDIA_ROOT=C:\ERP-Live\Backend\media

# Set True only if an HTTPS reverse proxy (Caddy/Nginx) sits in front of Waitress
ENABLE_HTTPS=False
