# Django LAN / Production Environment Template
# Copy this file to Backend/.env (and NEVER commit Backend/.env to Git)

# Set False for Live LAN server, True only for local development
DJANGO_DEBUG=False

# Generate a strong random secret key (setup-live-lan.ps1 generates one automatically)
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key

# Comma-separated hostnames/IPs allowed to access the ERP
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,192.168.1.50

# Optional extra CORS origins (same-origin LAN mode does not need extra CORS)
# DJANGO_CORS_ALLOWED_ORIGINS=http://192.168.1.50:8000

# Database: "sqlite" (default) or "postgres"
DB_ENGINE=sqlite
# DB_NAME=erp_furniture_db
# DB_USER=erp_app_user
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_SSLMODE=disable

# Optional custom media folder path (defaults to Backend/media)
# DJANGO_MEDIA_ROOT=C:\ERP-Live\Backend\media

# Set True only if you put an HTTPS reverse proxy (Caddy/Nginx) in front of Waitress
DJANGO_ENABLE_HTTPS=False
