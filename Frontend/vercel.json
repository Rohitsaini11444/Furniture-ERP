{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://furniture-erp-production-1811.up.railway.app/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://furniture-erp-production-1811.up.railway.app/media/$1"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}