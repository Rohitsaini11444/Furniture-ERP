{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://furniture-erp-vlzq.onrender.com/api/$1"
    },
    {
      "source": "/media/(.*)",
      "destination": "https://furniture-erp-vlzq.onrender.com/media/$1"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}